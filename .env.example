# ==============================================================================
# CrackIt - Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/job_assistant
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret (generate a secure random 256-bit string in production)
JWT_SECRET=your_jwt_secret_key_here

# External Job Discovery API Keys
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JSEARCH_API_KEY=your_jsearch_api_key
GEODB_API_KEY=your_geodb_api_key

# Python AI Service
GEMINI_API_KEY=your_google_gemini_api_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_MOCK_MODE=true

