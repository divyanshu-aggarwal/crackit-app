# ==========================================
# CrackIt Spring Boot Backend Environment Variables
# ==========================================

# Server Configuration
SERVER_PORT=5981

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/job_assistant
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_SQL_INIT_MODE=always

# Python AI Microservice URL
AI_SERVICE_URL=http://localhost:8000/api/ai

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# External Discovery APIs
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JSEARCH_API_KEY=your_rapidapi_jsearch_key
GEODB_API_KEY=your_rapidapi_geodb_key
GEODB_API_HOST=wft-geo-db.p.rapidapi.com

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
