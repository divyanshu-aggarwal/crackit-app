# ==============================================================================
# CrackIt - Root .gitignore
# ==============================================================================

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (Never commit credentials to a public repo!)
.env
.env.*
!.env.example
*.local

# Frontend (React / Vite)
crackit-ui/node_modules/
crackit-ui/dist/
crackit-ui/dist-ssr/
crackit-ui/.env
crackit-ui/.env.local

# Backend (Spring Boot / Maven)
crackit/target/
crackit/.mvn/
*.class
*.jar
*.war

# Python AI Service (FastAPI)
crackit-ai-service/venv/
crackit-ai-service/env/
crackit-ai-service/ENV/
crackit-ai-service/.env
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backup.sql
